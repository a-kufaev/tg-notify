#!/usr/bin/env -S python3 -I
"""Claude Code hook for tg-notify, one script for all its events (wired by install.sh):
- SessionStart: put the message format into the agent's context, quietly (startup, resume, clear, compact).
- Stop (HOOK_STOP): a fallback. When a turn did work (tool calls) but sent no summary, a one-line reminder;
  the UI shows it, so it fires only then and stays short.
- Notification (HOOK_PERMISSION): forward a permission prompt to Telegram.
- PreToolUse AskUserQuestion (HOOK_QUESTION): forward the question with its options.
Forwarded messages carry the reply link tg-notify appends, so they can be answered from the phone.
Settings: ~/.config/tg-notify/config, all keys in config.example.
"""
import json
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))  # the repo: this file is symlinked
sys.path.insert(0, os.path.join(ROOT, "lib"))
from tg_notify_config import load  # noqa: E402

TG = os.path.join(ROOT, "bin", "tg-notify")
ASKING_NOTIFICATIONS = {"permission_prompt", "elicitation_dialog"}
SETTINGS = load({
    "HOOK_STOP": "on",
    "HOOK_PERMISSION": "on",
    "HOOK_QUESTION": "on",
    "MESSAGE_LANGUAGE": "the user's language",
    "ASK_LABEL": "Action needed",
    "FORMAT_FILE": "",
    "QUESTION_TITLE": "question",
    "PERMISSION_TITLE": "waiting for permission",
})

STOP_REMINDER = "No Telegram summary this turn: send one per the tg-notify format if the turn has a result."
TRANSCRIPT_TAIL = 8 << 20  # bytes; one turn fits easily
# A real send: tg-notify run on the command's first line, not the word inside a heredoc or a file edit.
SEND = re.compile(r"^(?:.*(?:&&|;|\|\|)\s*)?(?:\S*/)?tg-notify(?:\s|$)")
CONTEXT = """# Telegram summaries (tg-notify)
In a turn with a result (final or interim) or a question for the user, send one summary with tg-notify as
the last step before your final reply. A short reply with no work behind it: send nothing.
Write in {language}; the ask label is "{ask}". Format (`tg-notify --format` prints it again):

{format}"""


def enabled(key: str) -> bool:
    return SETTINGS[key].lower() not in ("off", "no", "false", "0")


def project(cwd: str) -> str:
    """Project folder name; a session worktree (<repo>/.claude/worktrees/x) reports its repo."""
    return os.path.basename(cwd.split("/.claude/worktrees/")[0].rstrip("/")) or "Claude"


def send(text: str) -> None:
    # Synchronous on purpose: tg-notify finds the reply link through this process's ancestors.
    subprocess.run([TG, text], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)


def context() -> str:
    path = os.path.expanduser(SETTINGS["FORMAT_FILE"]) or os.path.join(ROOT, "FORMAT.md")
    with open(path, encoding="utf-8") as spec:
        spec_text = spec.read()
    ask = SETTINGS["ASK_LABEL"] or "Action needed"
    return CONTEXT.format(language=SETTINGS["MESSAGE_LANGUAGE"], ask=ask, format=spec_text)


def turn(transcript: str) -> tuple[bool, bool]:
    """(worked, sent) for the current turn: it made a tool call; one of them ran tg-notify.
    The turn starts at the last prompt the user typed (tool results and hook notes are not prompts)."""
    worked = sent = False
    try:
        with open(transcript, "rb") as log:
            log.seek(max(0, os.path.getsize(transcript) - TRANSCRIPT_TAIL))
            lines = log.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return True, False  # unknown: remind
    for line in reversed(lines):
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        message = entry.get("message")
        content = message.get("content") if isinstance(message, dict) else None
        items = [c for c in content if isinstance(c, dict)] if isinstance(content, list) else []
        if entry.get("type") == "user" and not entry.get("isMeta"):
            if isinstance(content, str) or any(c.get("type") in ("text", "image") for c in items):
                break
        if entry.get("type") == "assistant":
            for call in (c for c in items if c.get("type") == "tool_use"):
                worked = True
                command = str(call.get("input", {}).get("command", ""))
                sent = sent or bool(SEND.match(command.split("\n", 1)[0].strip()))
    return worked, sent


def reply(payload: dict) -> None:
    print(json.dumps(payload, ensure_ascii=False))


def main() -> None:
    event = json.load(sys.stdin)
    kind = event.get("hook_event_name")
    name = project(event.get("cwd", ""))

    if kind == "SessionStart" and enabled("HOOK_STOP"):
        reply({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": context()}})

    elif kind == "Stop" and enabled("HOOK_STOP"):
        worked, sent = turn(event.get("transcript_path", ""))
        if worked and not sent and not event.get("stop_hook_active"):  # second stop: let it end
            reply({"decision": "block", "reason": STOP_REMINDER})

    elif kind == "Notification" and enabled("HOOK_PERMISSION"):
        message = event.get("message", "")
        reason = event.get("notification_type")
        if reason in ASKING_NOTIFICATIONS or (reason is None and "permission" in message.lower()):
            send(f"⏸ **{name}: {SETTINGS['PERMISSION_TITLE']}**\n\n{message}")

    elif kind == "PreToolUse" and event.get("tool_name") == "AskUserQuestion" and enabled("HOOK_QUESTION"):
        lines = [f"❓ **{name}: {SETTINGS['QUESTION_TITLE']}**"]
        for question in event.get("tool_input", {}).get("questions", []):
            lines += ["", question.get("question", "")]  # the renderer glues the options to a "?" line
            lines += [f"- {option.get('label', '')}" for option in question.get("options", [])]
        send("\n".join(lines))


main()
