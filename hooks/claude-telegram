#!/usr/bin/env -S python3 -I
"""Claude Code hook for tg-notify, one script for three events (wired by `install.sh --claude`):
- Stop (HOOK_STOP): ask Claude to send its turn summary (a final or interim result, or a question) via
  tg-notify. The reminder carries the format file, so every session, a long-running one too, writes to
  the current format. Claude skips trivial replies and turns where it already sent one.
- Notification (HOOK_PERMISSION): forward a permission prompt to Telegram.
- PreToolUse AskUserQuestion (HOOK_QUESTION): forward the question with its options.
Forwarded messages carry the reply link tg-notify appends, so they can be answered from the phone.
Settings: ~/.config/tg-notify/config, all keys in config.example.
"""
import json
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))  # the repo: this file is symlinked
sys.path.insert(0, os.path.join(ROOT, "lib"))
from tg_notify_config import load  # noqa: E402

TG = os.path.join(ROOT, "bin", "tg-notify")
ASKING_NOTIFICATIONS = {"permission_prompt", "elicitation_dialog"}
SETTINGS = load({
    "HOOK_STOP": "on",
    "HOOK_PERMISSION": "on",
    "HOOK_QUESTION": "on",
    "MESSAGE_LANGUAGE": "the user's language",
    "FORMAT_FILE": "",
    "QUESTION_TITLE": "question",
    "PERMISSION_TITLE": "waiting for permission",
})

STOP_REASON = (
    "Turn finished. If it has a result (final or interim) or needs the user's answer, and you have not sent "
    "a summary this turn, send one to Telegram with tg-notify, in {language}, following the format below. "
    "A short reply with no work behind it: send nothing. Then stop, with no new text in the chat.\n\n"
)


def enabled(key: str) -> bool:
    return SETTINGS[key].lower() not in ("off", "no", "false", "0")


def project(cwd: str) -> str:
    """Project folder name; a session worktree (<repo>/.claude/worktrees/x) reports its repo."""
    return os.path.basename(cwd.split("/.claude/worktrees/")[0].rstrip("/")) or "Claude"


def send(text: str) -> None:
    # Synchronous on purpose: tg-notify finds the reply link through this process's ancestors.
    subprocess.run([TG, text], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)


def stop_reason() -> str:
    path = os.path.expanduser(SETTINGS["FORMAT_FILE"]) or os.path.join(ROOT, "FORMAT.md")
    with open(path, encoding="utf-8") as spec:
        return STOP_REASON.format(language=SETTINGS["MESSAGE_LANGUAGE"]) + spec.read()


def main() -> None:
    event = json.load(sys.stdin)
    kind = event.get("hook_event_name")
    name = project(event.get("cwd", ""))

    if kind == "Stop" and enabled("HOOK_STOP"):
        if not event.get("stop_hook_active"):  # second stop of the same turn: let it end
            print(json.dumps({"decision": "block", "reason": stop_reason()}, ensure_ascii=False))

    elif kind == "Notification" and enabled("HOOK_PERMISSION"):
        message = event.get("message", "")
        reason = event.get("notification_type")
        if reason in ASKING_NOTIFICATIONS or (reason is None and "permission" in message.lower()):
            send(f"⏸ **{name}: {SETTINGS['PERMISSION_TITLE']}**\n\n{message}")

    elif kind == "PreToolUse" and event.get("tool_name") == "AskUserQuestion" and enabled("HOOK_QUESTION"):
        lines = [f"❓ **{name}: {SETTINGS['QUESTION_TITLE']}**"]
        for question in event.get("tool_input", {}).get("questions", []):
            lines += ["", question.get("question", "")]  # the renderer glues the options to a «?» line
            lines += [f"- {option.get('label', '')}" for option in question.get("options", [])]
        send("\n".join(lines))


main()
